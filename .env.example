SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Domaine public de l'application, sans barre oblique finale.
# Indispensable derrière un reverse proxy (Dokploy / Traefik) : le serveur
# écoute sur 0.0.0.0:3000 et ne peut pas deviner seul le nom de domaine.
# Sert à construire les redirections de connexion Google.
# En développement local, laisser vide : les en-têtes suffisent.
APP_URL=https://mealquest.example.com

# Clé de service Supabase (Project Settings -> API -> service_role).
# Réservée au serveur : elle court-circuite RLS et ne doit JAMAIS porter le
# préfixe NEXT_PUBLIC_ ni apparaître côté navigateur.
# Sert uniquement à déchiffrer la clé du fournisseur d'IA.
SUPABASE_SERVICE_ROLE_KEY=<coller la cle service_role du projet Supabase>
